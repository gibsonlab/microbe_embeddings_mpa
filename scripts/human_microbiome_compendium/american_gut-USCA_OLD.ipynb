    "    \"    \\\"   \\\\\\\"outputs\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    {\\\\n\\\",\\n\",\n",
    "    \"    \\\"     \\\\\\\"data\\\\\\\": {\\\\n\\\",\\n\",\n",
    "    \"    \\\"      \\\\\\\"application/vnd.jupyter.widget-view+json\\\\\\\": {\\\\n\\\",\\n\",\n",
    "    \"    \\\"       \\\\\\\"model_id\\\\\\\": \\\\\\\"7b23566e8c774b2eb9c52940897d6401\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"       \\\\\\\"version_major\\\\\\\": 2,\\\\n\\\",\\n\",\n",
    "    \"    \\\"       \\\\\\\"version_minor\\\\\\\": 0\\\\n\\\",\\n\",\n",
