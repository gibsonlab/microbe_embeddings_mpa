    "    \"    \\\"    \\\\\\\"def precompute_embeddings(create_embed_model: Callable[[], GenomeEmbedding], output_file: Path, batch_size: int = 50, **embed_kwargs):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
