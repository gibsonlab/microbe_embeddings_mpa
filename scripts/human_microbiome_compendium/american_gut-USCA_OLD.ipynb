    "    \"    \\\"    \\\\\\\"def boxplot_with_paired_significance(data, hue, y, sample_col, ax=None, hue_order=None, palette=None, correction='fdr_bh'):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    Draws a seaborn boxplot and annotates pairwise *paired* statistical significance between hue groups, matching by 'Sample' column.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    Uses paired Wilcoxon test with multiple hypothesis correction.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
