    "    \"    \\\"    \\\\\\\"Run BLAST validation. \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"Note: this may take anywhere between 6-24 hours (on Alienware aurora r16, 'nt' database hosted in /data/cctm), depending on query size and database disk i/o throughput.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"from validate_16s import validate_all_16s\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
