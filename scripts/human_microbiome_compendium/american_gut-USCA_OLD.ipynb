    "    \"    \\\"     \\\\\\\"name\\\\\\\": \\\\\\\"stdout\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"     \\\\\\\"output_type\\\\\\\": \\\\\\\"stream\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"     \\\\\\\"text\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"      \\\\\\\"Permutation invariance & masking validation check complete!\\\\\\\\n\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"     ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    }\\\\n\\\",\\n\",\n",
