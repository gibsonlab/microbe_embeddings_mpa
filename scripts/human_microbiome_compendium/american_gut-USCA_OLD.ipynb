    "    \"    \\\"    \\\\\\\"    # Draw the box plot: only x=hue, y=value\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    sb.boxplot(x=hue, y=y, hue=hue, data=data, ax=ax, order=hue_order, hue_order=hue_order, palette=palette, dodge=False, legend=False, showfliers=False)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    sb.stripplot(x=hue, y=y, hue=hue, data=data, ax=ax, order=hue_order, hue_order=hue_order, palette=palette, dodge=False, alpha=0.5, edgecolor='black', linewidth=1.0)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    ax.set_xticklabels(hue_order, rotation=30)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Get y-axis range for proper scaling\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    ylim = ax.get_ylim()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    y_range = ylim[1] - ylim[0]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    y_max = data[y].max()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Starting position for annotations (4% above data max)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    y_start = y_max + y_range * 0.04\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Pairwise significance testing\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    pairs = list(itertools.combinations(hue_order, 2))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    p_values = []\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    test_results = []\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Collect all p-values first\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    for h1, h2 in pairs:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        d1 = data[data[hue] == h1][[sample_col, y]]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        d2 = data[data[hue] == h2][[sample_col, y]]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        joined = d1.merge(d2, on=sample_col, suffixes=('_1', '_2'))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        v1 = joined[y + '_1']\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        v2 = joined[y + '_2']\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        stat, p = wilcoxon(v1, v2, zero_method='wilcox', correction=False)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        p_values.append(p)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        test_results.append((h1, h2, stat, p))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Apply multiple hypothesis correction\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    if len(p_values) > 1:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        rejected, p_corrected, _, _ = smt.multipletests(p_values, method=correction)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    else:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        rejected = [p_values[0] < 0.05] if p_values else []\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        p_corrected = p_values\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Annotation with corrected p-values\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    annotation_idx = 0  # Counter for positioning annotations\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    for idx, (h1, h2, stat, p_raw) in enumerate(test_results):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        p_adj = p_corrected[idx]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        stars = '***' if p_adj < 0.001 else '**' if p_adj < 0.01 else '*' if p_adj < 0.05 else 'n.s.'\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        x1, x2 = group_locs[h1], group_locs[h2]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        # Calculate bracket position and height based on y-axis range\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        y_bar = y_start + annotation_idx * y_range * 0.15  # 15% spacing between brackets\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        bracket_height = y_range * 0.02  # 2% of y-range for bracket height\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        text_offset = y_range * 0.001  # offset for text above bracket\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        # Draw significance bracket\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        ax.plot([x1, x1, x2, x2], \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"                [y_bar, y_bar + bracket_height, y_bar + bracket_height, y_bar], \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"                lw=1.2, c='k')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        # Add significance text with adjusted p-value info\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        text = f\\\\\\\\\\\\\\\"{stars}\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        ax.text((x1 + x2) / 2, y_bar + bracket_height + text_offset, \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"                text, ha='center', va='bottom', color='k', fontsize=11)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        annotation_idx += 1\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Add correction method info to plot\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    ax.text(0.02, 0.98, f'Multiple comparisons: {correction}', \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            transform=ax.transAxes, verticalalignment='top', fontsize=10, \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            bbox=dict(boxstyle='round,pad=0.3', facecolor='lightgray', alpha=0.7))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.tight_layout()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    return ax\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  },\\\\n\\\",\\n\",\n",
