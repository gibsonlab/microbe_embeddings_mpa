    "    \"    \\\"   \\\\\\\"source\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"def hamming_distance(seq1: str, seq2: str) -> int:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    assert len(seq1) == len(seq2), \\\\\\\\\\\\\\\"For Hamming distance, sequences must be of equal length after alignment.\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    distance = sum(1 for x, y in zip(seq1, seq2) if x != y)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    return distance\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"class ASVDistanceMatrix:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    def __init__(self, id_ordering: List[str], matrix: np.ndarray):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        self.id_ordering = id_ordering\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        self.asv_to_idx = {asv_id: i for i, asv_id in enumerate(self.id_ordering)}\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        self.matrix = matrix\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    def entry(self, asv_i: str, asv_j: str) -> int:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        return self.matrix[self.asv_to_idx[asv_id], self.asv_to_idx[asv_id]]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    def nearest_neighbor(self, query: str, database: Set[str], neighbor_rank: int = 0) -> str:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        Assuming query and database are all in self.id_ordering, return the nearest neighbor to the query.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        assert neighbor_rank < len(database), \\\\\\\\\\\\\\\"Can't request a neighbor rank of '{neighbor_rank}' when the database is of size {len(database)}!\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        if query in database:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            return query  # guaranteed distance of zero.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        database = list(database)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        database_indices = [self.asv_to_idx[asv] for asv in database]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        query_row = self.matrix[self.asv_to_idx[query], :]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        query_row = query_row[database_indices]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        best_idx = np.argsort(query_row)[neighbor_rank]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        return database[best_idx]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    @staticmethod\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    def from_alignment(aln_fasta: Path) -> Self:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        # Parse multiple alignment output.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(f\\\\\\\\\\\\\\\"Loading alignments from {aln_fasta}\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        aligned_sequences = {}\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        with open(aln_fasta, 'r') as handle:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            for record in SeqIO.parse(handle, \\\\\\\\\\\\\\\"fasta\\\\\\\\\\\\\\\"):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"                aligned_sequences[record.id] = str(record.seq).upper()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        id_ordering = sorted(aligned_sequences.keys())\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        # Fill in the matrix\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        N = len(id_ordering)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        matrix = np.zeros(shape=(N, N), dtype=int)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(f\\\\\\\\\\\\\\\"Populating {N} x {N} distance matrix...\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        for (i, asv_i), (j, asv_j) in tqdm(itertools.combinations(enumerate(id_ordering), r=2), total=N*(N-1) // 2):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            _d = hamming_distance(aligned_sequences[asv_i], aligned_sequences[asv_j])\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            matrix[i, j] = _d\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"            matrix[j, i] = _d\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(\\\\\\\\\\\\\\\"Done.\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        return ASVDistanceMatrix(id_ordering, matrix)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    def save(self, path: Path):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        np.savez(path, ids=np.array(self.id_ordering, dtype=object), matrix=self.matrix)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    @staticmethod\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    def load(path: Path) -> Self:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(f\\\\\\\\\\\\\\\"Loading matrix from file {path}\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        data = np.load(path, allow_pickle=True)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        id_ordering = list(data['ids'])\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        matrix = data['matrix']\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        return ASVDistanceMatrix(id_ordering, matrix)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"matrix_file = NOTEBOOK_CACHE / \\\\\\\\\\\\\\\"distance_matrix.npz\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"if matrix_file.exists():\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    asv_distance_matrix = ASVDistanceMatrix.load(matrix_file)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"else:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    asv_distance_matrix = ASVDistanceMatrix.from_alignment(alignment_file)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    asv_distance_matrix.save(matrix_file)\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
