    "    \"    \\\"    \\\\\\\"print(\\\\\\\\\\\\\\\"[*] Stage 1 filter: {} samples remaining\\\\\\\\\\\\\\\".format(sample_subset.shape[0]))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
