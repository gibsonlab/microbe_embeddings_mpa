    "    \"    \\\"    \\\\\\\"        counts_table = pd.read_csv(f, sep='\\\\\\\\\\\\\\\\t').set_index(\\\\\\\\\\\\\\\"asv\\\\\\\\\\\\\\\")    # load from file\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
